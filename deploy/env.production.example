# /etc/white-label/<client>/env   (owner root, group wl-<client>, mode 0640)
#
# One file per client. systemd reads it with EnvironmentFile=, so: one
# KEY=value per line, no `export`, no quotes around values with no spaces, no
# $variables. The app reads the same variables from the process environment.
# Variables not listed here keep Renox's defaults (see the Renox
# docs/operations.md "All settings").

# ---- Required: the app refuses to boot without these in production ----------

# production: strict cookies, HSTS (with an https APP_URL), no debug pages.
# Anything but local/testing/production stops the app at boot.
APP_ENV=production
APP_DEBUG=false

# Secret for sessions, signed links and encrypted fields. Generate once per
# client: `printf 'base64:%s\n' "$(head -c 32 /dev/urandom | base64)"`.
# Keep a copy with the backups: without it every session and every encrypted
# value is lost (restore needs the same key). Boot error without it:
# "APP_KEY must be set in production".
APP_KEY=base64:CHANGE-ME

# The client's client.toml (branding, legal entities, enabled modules). Boot
# error without it in production: "CLIENT_CONFIG is not set: name the client's
# client.toml". Outside production the demo client is used when unset, so a
# missing line here is only noticed in production.
CLIENT_CONFIG=/etc/white-label/CLIENT/client.toml

# ---- Address and proxy --------------------------------------------------------

# The public address. https:// marks cookies Secure and, with APP_ENV=production,
# sends HSTS. Links in e-mails (verification, password reset) are built from it.
# Over plain http the session cookie is not sent back: sign-in appears to do
# nothing. Do not test an https APP_URL by browsing to http://127.0.0.1:PORT.
APP_URL=https://CLIENT.example.ae

# Where the app listens when it is not started through the socket. With
# systemd socket activation the socket decides (ListenStream in the .socket
# drop-in); keep both the same. 127.0.0.1: only Caddy on this host may connect.
APP_HOST=127.0.0.1
APP_PORT=3101

# The host names the app answers to; any other Host gets 400. The host of
# APP_URL is always allowed and /health answers for any host.
TRUSTED_HOSTS=CLIENT.example.ae
# Caddy runs on the same host. Set this only when nobody can reach the app
# port directly (it listens on 127.0.0.1), otherwise X-Forwarded-For can be
# faked and rate limits and the login lock can be bypassed.
TRUSTED_PROXIES=127.0.0.1

# ---- Data ---------------------------------------------------------------------

# SQLite file of this client. ?mode=rwc creates the file on first use.
# Litestream replicates exactly this path (litestream.yml).
DATABASE_URL=sqlite:///var/lib/white-label/CLIENT/app.db?mode=rwc
DATABASE_POOL_SIZE=8
# Uploads live in STORAGE_PATH/app; back them up as well (deploy/README.md).
STORAGE_PATH=/var/lib/white-label/CLIENT

# ---- Locale and time ----------------------------------------------------------

# The business calendar (working days, midday break) is Asia/Dubai in code;
# this is the zone Renox uses for schedules and displayed times. UAE: UTC+4,
# no daylight saving.
APP_TIMEZONE=Asia/Dubai
# Default language; "ar" pages render right-to-left. Visitors' browser
# language wins where the app has it.
APP_LOCALE=en
APP_CURRENCY=AED

# ---- Mail ---------------------------------------------------------------------

# `log` only writes the mail to the journal (verification links included): fine
# for the first install, never for go-live. Use smtp.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.ae
MAIL_PORT=587
# tls (usually 465), starttls (usually 587) or none.
MAIL_ENCRYPTION=starttls
MAIL_USERNAME=CHANGE-ME
MAIL_PASSWORD=CHANGE-ME
MAIL_FROM_ADDRESS=no-reply@CLIENT.example.ae
MAIL_FROM_NAME="Client name"
# Seconds before a send is given up and retried by the queue.
MAIL_TIMEOUT=10

# ---- Background work ----------------------------------------------------------

# Queue workers and the scheduler run inside `serve`. Rules, chases, statements
# and reminders depend on them: keep SCHEDULER=true on exactly one process per
# database.
QUEUE_WORKERS=2
SCHEDULER=true

# ---- Browser security ---------------------------------------------------------

# relaxed (default): scripts from this site, inline scripts and eval, which the
# current pages need. strict: nonce-only scripts and Alpine's CSP build; the
# host's pages are not yet checked under strict, so do not switch it on
# before a page-by-page test (deploy/README.md, status table).
CSP=relaxed
PERMISSIONS_POLICY=default

# ---- Logs ---------------------------------------------------------------------

# Logs go to stdout, i.e. the journal: `journalctl -u white-label@CLIENT`.
# json: one object per line, with the request id, for log tools.
LOG_FORMAT=text
RUST_LOG=info,sqlx=warn
