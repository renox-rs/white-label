# /etc/systemd/system/white-label@.socket
#
# systemd holds the listening socket and hands it to white-label@%i.service
# (Renox reads LISTEN_FDS), so a deploy or a crash makes visitors wait a moment
# instead of getting "connection refused".
#
# Every client needs its own port. Do NOT edit this file: give each client a
# drop-in, see deploy/README.md section "First install of a client":
#   /etc/systemd/system/white-label@acme.socket.d/listen.conf
#   [Socket]
#   ListenStream=
#   ListenStream=127.0.0.1:3100
# The port must equal APP_HOST:APP_PORT in /etc/white-label/<client>/env and the
# port in the client's Caddy block.
[Unit]
Description=White-label app for client %i (listening socket)

[Socket]
ListenStream=127.0.0.1:3000
# Connections that may wait while the app restarts.
Backlog=4096

[Install]
WantedBy=sockets.target
